{
  "schema": "line-manifest/v1",
  "line": "finddata-business",
  "public_base_url": "https://mcp.finddatatech.cloud/fd-find-data-business-mcp",
  "identity": {
    "issuer": "https://auth.finddatatech.cloud/oidc",
    "jwks_uri": "https://auth.finddatatech.cloud/oidc/jwks",
    "jit_policy": "off"
  },
  "auth_tracks": [
    {
      "kind": "line-native",
      "name": "fdbiz-internal-token",
      "accepts": "line-native-key",
      "fallback": true
    },
    {
      "kind": "member-assertion",
      "name": "logto-jwt",
      "accepts": "line-native-key",
      "fallback": true
    },
    {
      "kind": "customer-key",
      "accepts": "ciyuan-sk",
      "fallback": false,
      "enforced": false,
      "migration_task": "converge-line-identity-and-keys#8.3"
    }
  ],
  "scopes": [
    "line:read"
  ],
  "billing": {
    "plane": "ciyuan"
  },
  "surfaces": {
    "mcp": true,
    "account": false,
    "admin": false
  }
}
